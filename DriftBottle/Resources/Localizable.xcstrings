    "ai.notice_full": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حارس المنارة رفيق بالذكاء الاصطناعي، وليس مستخدمًا حقيقيًا. حين يصل مسافرون آخرون إلى هذا البحر، ستنجرف زجاجاتك إلى أشخاص حقيقيين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Leuchtturmwärter ist ein KI-Begleiter, kein echter Mensch. Sobald andere Reisende an dieses Meer kommen, treiben deine Flaschen zu echten Menschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Lighthouse Keeper is an AI companion, not a real person. As soon as other travelers reach this sea, your bottles will drift to real people."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Farero es un acompañante con IA, no una persona real. En cuanto lleguen otros viajeros a este mar, tus botellas irán a parar a personas reales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Gardien du phare est un compagnon IA, pas une vraie personne. Dès que d'autres voyageurs arriveront sur cette mer, vos bouteilles iront vers de vraies personnes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penjaga Mercusuar adalah teman AI, bukan pengguna sungguhan. Begitu ada pelancong lain yang datang ke laut ini, botolmu akan hanyut ke orang sungguhan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Guardiano del faro è un compagno IA, non una persona reale. Appena altri viaggiatori arriveranno in questo mare, le tue bottiglie andranno a persone reali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灯台守はAIのキャラクターで、実在のユーザーではありません。ほかの旅人がこの海に来たら、あなたのボトルは実在の人のもとへ流れていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등대지기는 AI 캐릭터이며 실제 사용자가 아닙니다. 다른 여행자가 이 바다에 오면 당신의 유리병은 실제 사람에게 떠갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Faroleiro é um companheiro de IA, não uma pessoa real. Assim que outros viajantes chegarem a este mar, suas garrafas vão para pessoas reais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотритель маяка — это ИИ-собеседник, а не живой человек. Как только к этому морю придут другие путники, ваши бутылки поплывут к живым людям."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้เฝ้าประภาคารเป็นเพื่อนคุย AI ไม่ใช่ผู้ใช้จริง เมื่อมีนักเดินทางคนอื่นมาถึงทะเลนี้ ขวดของคุณจะลอยไปหาคนจริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fener Bekçisi bir yapay zekâ (YZ) arkadaştır, gerçek bir kullanıcı değildir. Bu denize başka yolcular gelir gelmez şişelerin gerçek insanlara sürüklenecek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người gác hải đăng là bạn đồng hành AI, không phải người dùng thật. Khi có lữ khách khác đến vùng biển này, chai của bạn sẽ trôi đến người thật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯塔守望者是 AI 陪伴角色，不是真实用户。一旦有其他旅人来到这片海，你的瓶子就会漂向真实的人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "燈塔守望者是 AI 陪伴角色，不是真實使用者。一旦有其他旅人來到這片海，你的瓶子就會漂向真實的人。"
          }
        }
      }
    },
