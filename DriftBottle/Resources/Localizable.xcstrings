    "chat.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب ما شئت، فالبحر يحفظ الأسرار…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib etwas – das Meer verrät nichts …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say something — the sea keeps secrets…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe algo; el mar guarda secretos…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez quelque chose, la mer garde les secrets…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis apa saja, laut akan menjaga rahasiamu…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi qualcosa, il mare sa mantenere i segreti…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なんでもどうぞ。海は秘密を守ります…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇이든 적어 보세요. 바다가 비밀을 지켜 줄 거예요…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva algo; o mar guarda segredos…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напишите что-нибудь — море умеет хранить тайны…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์อะไรก็ได้ ทะเลจะเก็บความลับให้…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şey yaz, deniz sırrını saklar…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viết gì đó đi, biển sẽ giữ bí mật…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写点什么，海会替你保密…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫點什麼，海會替你保密…"
          }
        }
      }
    },
