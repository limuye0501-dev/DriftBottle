    "onb.confirm_msg": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجنس: %1$@   العمر: %2$@\nلا يمكن التغيير بعد التأكيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschlecht: %1$@   Alter: %2$@\nDas lässt sich danach nicht mehr ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gender: %1$@   Age: %2$@\nThis can't be changed later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sexo: %1$@   Edad: %2$@\nNo podrás cambiarlo después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genre : %1$@   Âge : %2$@\nVous ne pourrez plus les modifier."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jenis kelamin: %1$@   Usia: %2$@\nSetelah dikonfirmasi tidak bisa diubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Genere: %1$@   Età: %2$@\nNon potrai modificarli in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "性別：%1$@　年齢：%2$@\n確定後は変更できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "성별: %1$@   나이: %2$@\n확인 후에는 변경할 수 없어요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gênero: %1$@   Idade: %2$@\nNão será possível alterar depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пол: %1$@   Возраст: %2$@\nПотом изменить будет нельзя."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพศ: %1$@   อายุ: %2$@\nยืนยันแล้วจะแก้ไขไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinsiyet: %1$@   Yaş: %2$@\nOnayladıktan sonra değiştirilemez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giới tính: %1$@   Tuổi: %2$@\nSau khi xác nhận sẽ không thể sửa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "性别：%1$@　年龄：%2$@\n确认后将无法修改"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "性別：%1$@　年齡：%2$@\n確認後將無法修改"
          }
        }
      }
    },
