    "paywall.h.first": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ردّ عليك أحدهم.\nلا تدع الرسالة التالية تنتظر طويلًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand hat geantwortet.\nLass die nächste nicht zu lange warten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone wrote back.\nDon't keep the next one waiting"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien te respondió.\nNo hagas esperar a la próxima"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu'un vous a répondu.\nNe faites pas trop attendre la suivante"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada yang membalas.\nJangan biarkan surat berikutnya menunggu lama"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcuno ti ha risposto.\nNon far aspettare la prossima"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信が届きました。\n次の一通を待たせないで"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답장이 왔어요.\n다음 편지를 너무 기다리게 하지 마세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém respondeu.\nNão deixe a próxima esperando"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вам ответили.\nНе заставляйте следующее письмо ждать"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีคนตอบคุณแล้ว\nอย่าปล่อยให้ฉบับต่อไปรอนาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biri yanıt verdi.\nSıradakini fazla bekletme"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có người trả lời rồi.\nĐừng để lá thư sau phải chờ lâu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人回信了。\n别让下一封等太久"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有人回信了。\n別讓下一封等太久"
          }
        }
      }
    },
    "paywall.h.manual": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد رمي بضع زجاجات أخرى الليلة؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute Nacht ein paar Flaschen mehr?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Want a few more bottles tonight?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Unas cuantas botellas más esta noche?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encore quelques bouteilles ce soir ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mau melempar beberapa botol lagi malam ini?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualche bottiglia in più stanotte?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今夜はもう少しボトルを流したい？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 밤 유리병을 조금 더 띄워 볼까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais algumas garrafas esta noite?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё пару бутылок этой ночью?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คืนนี้อยากโยนขวดเพิ่มอีกหน่อยไหม?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gece birkaç şişe daha?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muốn thả thêm vài chai đêm nay?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
