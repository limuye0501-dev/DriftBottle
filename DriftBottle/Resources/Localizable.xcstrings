    "first.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل غرفة الفندق هادئة أكثر من اللازم في رحلة العمل؟\nاكتب بضعة أسطر في زجاجة واتركها لبحر الليلة، والتقط زجاجة شخص آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Dienstreise und das Hotelzimmer ist zu still?\nSteck ein paar Zeilen in eine Flasche für das Meer von heute Nacht – und fisch die eines anderen heraus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotel room too quiet on a work trip?\nTuck a few lines into a bottle for tonight's sea — and fish out someone else's."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Demasiado silencio en la habitación del hotel?\nMete unas líneas en una botella para el mar de esta noche y pesca la de otra persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chambre d'hôtel trop calme en déplacement ?\nGlissez quelques lignes dans une bouteille pour la mer de ce soir, et repêchez celle de quelqu'un d'autre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamar hotel terlalu sepi saat dinas luar kota?\nTulis beberapa baris ke dalam botol untuk laut malam ini, dan pungut botol milik orang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera d'albergo troppo silenziosa in trasferta?\nMetti due righe in una bottiglia per il mare di stanotte e ripesca quella di qualcun altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出張先のホテル、夜が静かすぎる？\n短い言葉をボトルに詰めて今夜の海へ。誰かのボトルも拾ってみて。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출장지 호텔 방, 밤이 너무 조용한가요?\n몇 줄을 유리병에 담아 오늘 밤 바다에 띄우고, 다른 사람의 유리병도 주워 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quarto de hotel quieto demais na viagem a trabalho?\nColoque algumas linhas numa garrafa para o mar desta noite e pesque a de outra pessoa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В командировке, и в гостиничном номере слишком тихо?\nПоложите пару строк в бутылку для ночного моря — и выловите чужую."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไปทำงานต่างเมือง ห้องโรงแรมเงียบเกินไปไหม?\nเขียนสักสองสามบรรทัดใส่ขวดฝากทะเลคืนนี้ แล้วลองเก็บขวดของคนอื่นดูบ้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İş seyahatinde otel odası fazla mı sessiz?\nBirkaç satırı şişeye koyup bu gecenin denizine bırak, bir başkasının şişesini de topla."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đi công tác, phòng khách sạn yên ắng quá?\nViết vài dòng bỏ vào chai gửi biển đêm nay, và nhặt thử chai của người khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出差的夜里，酒店房间太安静？\n写几句话装进瓶子交给今晚的海，也去捡一个别人的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出差的夜裡，飯店房間太安靜？\n寫幾句話裝進瓶子交給今晚的海，也去撿一個別人的。"
          }
        }
      }
    },
