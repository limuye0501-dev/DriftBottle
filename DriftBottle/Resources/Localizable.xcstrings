    "letter.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا أعدتها ستنجرف إلى الشخص التالي · الحد الأقصى للردود لكل زجاجة: %ld"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurückgeworfen treibt sie weiter zur nächsten Person · max. %ld Antworten pro Flasche"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Throw it back and it drifts on to someone else · up to %ld replies per bottle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la devuelves, seguirá hacia otra persona · máximo %ld respuestas por botella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendue à la mer, elle repart vers quelqu'un d'autre · %ld réponses max par bouteille"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembalikan ke laut, botol akan hanyut ke orang berikutnya · maksimal %ld balasan per botol"
