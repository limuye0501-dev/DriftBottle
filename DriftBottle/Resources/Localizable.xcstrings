    "welcome.privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا تسجيل. لا نطلب رقم هاتف أو اسمًا أو بريدًا إلكترونيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Registrierung. Keine Telefonnummer, kein Name, keine E-Mail."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No sign-up. We never ask for your phone number, name or email."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin registro. No pedimos teléfono, nombre ni correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans inscription. Ni numéro de téléphone, ni nom, ni e-mail."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa daftar. Kami tidak meminta nomor HP, nama, atau email."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna registrazione. Niente numero di telefono, nome o e-mail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録不要。電話番号・名前・メールアドレスは一切集めません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가입 필요 없음. 전화번호·이름·이메일을 수집하지 않습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem cadastro. Não pedimos telefone, nome nem e-mail."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без регистрации. Не спрашиваем телефон, имя или почту."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องสมัครสมาชิก ไม่เก็บเบอร์โทร ชื่อ หรืออีเมล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt yok. Telefon numarası, ad veya e-posta istemiyoruz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần đăng ký. Không thu thập số điện thoại, tên hay email."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需注册，不收集手机号、姓名或邮箱"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需註冊，不收集手機號碼、姓名或Email"
          }
        }
      }
    },
    "welcome.tagline": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع ما في قلبك داخل زجاجة، واتركها لبحر الليلة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steck deine Gedanken in eine Flasche und übergib sie dem Meer von heute Nacht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put a thought in a bottle and let tonight's sea carry it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mete lo que piensas en una botella y deja que el mar de esta noche se la lleve"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez vos pensées dans une bouteille et confiez-la à la mer ce soir"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan isi hatimu ke dalam botol, titipkan pada laut malam ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti un pensiero in una bottiglia e affidalo al mare di stanotte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "想いをボトルに詰めて、今夜の海へ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마음을 유리병에 담아 오늘 밤 바다에 띄워 보세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque o que você sente numa garrafa e deixe o mar desta noite levar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Положите мысли в бутылку и доверьте их ночному морю"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่เรื่องในใจลงขวด แล้วฝากไว้กับทะเลคืนนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçindekileri bir şişeye koy, bu gecenin denizine bırak"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi tâm sự vào chai, để biển đêm nay mang đi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把心事装进瓶子，交给今晚的海"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把心事裝進瓶子，交給今晚的海"
          }
        }
      }
    }
  },
  "version": "1.0"
