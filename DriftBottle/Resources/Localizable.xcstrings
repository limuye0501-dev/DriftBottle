    "ai.first_visitor": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت أول زائر لهذا البحر. إلى حين وصول غيرك، سيرافقك حارس المنارة (ذكاء اصطناعي)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist der erste Besucher an diesem Meer. Bis dahin leistet dir der Leuchtturmwärter (KI) Gesellschaft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're the first visitor to this sea. The Lighthouse Keeper (AI) will keep you company for now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres el primer visitante de este mar. Mientras tanto, el Farero (IA) te hará compañía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes le premier visiteur de cette mer. En attendant, le Gardien du phare (IA) vous tient compagnie."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu pengunjung pertama laut ini. Sementara itu, Penjaga Mercusuar (AI) akan menemanimu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei il primo visitatore di questo mare. Nel frattempo ti farà compagnia il Guardiano del faro (IA)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたはこの海の最初の訪問者です。しばらくは灯台守（AI）がお相手します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 이 바다의 첫 방문자예요. 당분간은 등대지기(AI)가 말동무가 되어 드릴게요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você é o primeiro visitante deste mar. Por enquanto, o Faroleiro (IA) vai te fazer companhia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы первый гость этого моря. Пока что вам составит компанию Смотритель маяка (ИИ)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณคือผู้มาเยือนคนแรกของทะเลนี้ ระหว่างนี้ผู้เฝ้าประภาคาร (AI) จะอยู่เป็นเพื่อนคุณก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu denizin ilk ziyaretçisisin. Şimdilik Fener Bekçisi (YZ) sana eşlik edecek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn là vị khách đầu tiên của vùng biển này. Trong lúc chờ, Người gác hải đăng (AI) sẽ trò chuyện cùng bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是这片海的第一位访客，灯塔守望者（AI）先陪你聊聊"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你是這片海的第一位訪客，燈塔守望者（AI）先陪你聊聊"
          }
        }
      }
    },
