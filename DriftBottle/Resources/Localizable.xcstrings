      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون الاسم المستعار من 1 إلى 12 حرفًا وخاليًا من الألفاظ غير اللائقة"
          }
        },
        "de": {
