    "home.too_frequent": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رميت كثيرًا اليوم. خذ قسطًا من الراحة وعُد غدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute waren es ziemlich viele Flaschen. Mach eine Pause und komm morgen wieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's a lot of bottles today. Take a break and come back tomorrow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy has lanzado muchas. Descansa un poco y vuelve mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaucoup de bouteilles aujourd'hui. Faites une pause et revenez demain."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari ini sudah banyak sekali. Istirahat dulu, besok datang lagi ya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi ne hai lanciate tante. Fai una pausa e torna domani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日はたくさん流しましたね。ひと休みして、また明日どうぞ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 많이 띄웠네요. 잠깐 쉬고 내일 다시 와요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foram muitas garrafas hoje. Descanse um pouco e volte amanhã."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня бутылок было много. Отдохните и возвращайтесь завтра."
