    "paywall.s.first": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرد والدردشة مجانيان دائمًا. الاشتراك يزيد فقط عدد مرات الرمي والالتقاط اليومية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworten und Chatten sind immer kostenlos. Mit der Mitgliedschaft kannst du nur öfter werfen und fischen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replies and chats are always free. Membership just gives you more throws and picks each day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder y chatear siempre es gratis. La suscripción solo te da más lanzamientos y recogidas al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondre et discuter, c'est toujours gratuit. L'abonnement vous donne seulement plus de lancers et de pêches par jour."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membalas dan mengobrol selalu gratis. Langganan hanya menambah jatah lempar dan pungut per hari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondere e chattare è sempre gratis. L'abbonamento ti dà solo più lanci e ripescaggi al giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信とチャットはずっと無料。メンバーになると、1日に流せる・拾える回数が増えるだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답장과 대화는 언제나 무료예요. 멤버십은 하루에 띄우고 줍는 횟수만 늘려 줘요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder e conversar é sempre grátis. A assinatura só dá mais lançamentos e pescas por dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответы и чаты всегда бесплатны. Подписка лишь добавляет броски и улов в день."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอบกลับและแชตฟรีเสมอ สมาชิกแค่ช่วยให้โยนและเก็บขวดได้มากขึ้นต่อวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtlamak ve sohbet etmek her zaman ücretsiz. Üyelik sadece günlük atma ve toplama hakkını artırır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trả lời và trò chuyện luôn miễn phí. Gói thành viên chỉ giúp bạn thả và nhặt nhiều hơn mỗi ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
