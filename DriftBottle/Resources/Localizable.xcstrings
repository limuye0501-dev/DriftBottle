    "paywall.legal.cancel": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للإلغاء: إعدادات iPhone ← Apple ID ← الاشتراكات ← رسالة في زجاجة ← إلغاء الاشتراك، أو اضغط «إدارة الاشتراك» أدناه. تبقى المزايا حتى نهاية الفترة الحالية. يمكنك التبديل بين الشهري والسنوي في أي وقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So kündigst du: iPhone-Einstellungen → deine Apple-ID → Abonnements → Flaschenpost → Abo kündigen, oder tippe unten auf „Abo verwalten“. Die Vorteile bleiben bis zum Ende des laufenden Zeitraums erhalten. Du kannst jederzeit zwischen Monats- und Jahresabo wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To cancel: iPhone Settings → your Apple ID → Subscriptions → Drift Bottle → Cancel Subscription, or tap “Manage Subscription” below. Benefits last until the end of the current period. You can switch between monthly and annual at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cancelar: Ajustes del iPhone → tu Apple ID → Suscripciones → Botella al Mar → Cancelar suscripción, o toca «Gestionar suscripción» abajo. Conservas las ventajas hasta el final del periodo actual. Puedes cambiar entre mensual y anual en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour résilier : Réglages de l'iPhone → votre identifiant Apple → Abonnements → Bouteille à la mer → Annuler l'abonnement, ou touchez « Gérer l'abonnement » ci-dessous. Les avantages restent actifs jusqu'à la fin de la période en cours. Vous pouvez passer du mensuel à l'annuel à tout moment."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cara membatalkan: Pengaturan iPhone → ID Apple-mu → Langganan → Pesan dalam Botol → Batalkan Langganan, atau ketuk “Kelola Langganan” di bawah. Keuntungan tetap berlaku sampai akhir periode berjalan. Kamu bisa beralih antara bulanan dan tahunan kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per disdire: Impostazioni dell'iPhone → il tuo ID Apple → Abbonamenti → Messaggio in Bottiglia → Annulla abbonamento, oppure tocca «Gestisci abbonamento» qui sotto. I vantaggi restano fino alla fine del periodo in corso. Puoi passare da mensile ad annuale in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解約方法：iPhoneの「設定」→ Apple ID →「サブスクリプション」→「ボトルメール」→「サブスクリプションをキャンセル」、または下の「サブスクリプションを管理」から。解約後も現在の期間終了まで特典をご利用いただけます。月額と年額はいつでも切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해지 방법: iPhone '설정' → Apple ID → '구독' → '유리병 편지' → '구독 취소', 또는 아래 '구독 관리'를 누르세요. 해지 후에도 현재 기간이 끝날 때까지 혜택이 유지됩니다. 월간과 연간은 언제든 서로 전환할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cancelar: Ajustes do iPhone → seu ID Apple → Assinaturas → Garrafa ao Mar → Cancelar assinatura, ou toque em “Gerenciar assinatura” abaixo. Os benefícios continuam até o fim do período atual. Você pode alternar entre mensal e anual a qualquer momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как отменить: «Настройки» iPhone → ваш Apple ID → «Подписки» → «Письмо в бутылке» → «Отменить подписку» или нажмите «Управлять подпиской» ниже. Преимущества сохранятся до конца текущего периода. Переключаться между месячной и годовой подпиской можно в любое время."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิธียกเลิก: “การตั้งค่า” ของ iPhone → Apple ID ของคุณ → “การสมัครใช้งาน” → “จดหมายในขวด” → “ยกเลิกการสมัครใช้งาน” หรือแตะ “จัดการการสมัคร” ด้านล่าง หลังยกเลิกยังใช้สิทธิ์ได้จนสิ้นสุดรอบปัจจุบัน สลับระหว่างรายเดือนและรายปีได้ทุกเมื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal için: iPhone Ayarlar → Apple Kimliğin → Abonelikler → Şişedeki Mektup → Aboneliği İptal Et ya da aşağıdaki “Aboneliği Yönet”e dokun. Avantajlar mevcut dönem sonuna kadar sürer. Aylık ve yıllık arasında istediğin zaman geçiş yapabilirsin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cách huỷ: “Cài đặt” trên iPhone → Apple ID của bạn → “Đăng ký” → “Thư trong chai” → “Huỷ đăng ký”, hoặc nhấn “Quản lý gói đăng ký” bên dưới. Quyền lợi vẫn được giữ đến hết kỳ hiện tại. Có thể chuyển đổi giữa gói tháng và gói năm bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如何取消：iPhone「设置」→ 你的 Apple ID →「订阅」→「漂流瓶」→「取消订阅」，或点下方「管理订阅」。取消后权益保留到当期结束。月卡与年卡可随时互相切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如何取消：iPhone「設定」→ 你的 Apple ID →「訂閱」→「漂流瓶」→「取消訂閱」，或點下方「管理訂閱」。取消後權益保留到當期結束。月卡與年卡可隨時互相切換。"
          }
        }
      }
    },
    "paywall.legal.refund": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاسترداد: الاشتراك خدمة رقمية تُفعَّل فورًا ولا نقدم استردادًا. تتولى Apple طلبات الاسترداد وفق سياساتها (reportaproblem.apple.com). إذا وافقت على الخيار أعلاه، فسنشارك بيانات الاستخدام (مثل عدد مرات الرمي والالتقاط، دون محتوى المحادثات) مع Apple عند مراجعة الطلب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rückerstattung: Die Mitgliedschaft ist ein digitaler Dienst, der sofort wirksam wird; wir bieten keine Rückerstattungen an. Anfragen bearbeitet Apple nach seinen Richtlinien (reportaproblem.apple.com). Wenn du der Option oben zustimmst, übermitteln wir Apple bei einer Anfrage deine Nutzungsdaten (z. B. Anzahl der Würfe/Funde, niemals Chatinhalte)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refunds: membership is a digital service that takes effect immediately, and we don't offer refunds. Refund requests are handled by Apple under its policies (reportaproblem.apple.com). If you agree to the option above, we'll share your usage (such as numbers of throws/picks, never chat content) with Apple when it reviews a refund request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reembolsos: la suscripción es un servicio digital que se activa al instante y no ofrecemos reembolsos. Apple gestiona las solicitudes de reembolso según sus políticas (reportaproblem.apple.com). Si aceptas la opción de arriba, compartiremos con Apple tu uso (como el número de lanzamientos/recogidas, nunca el contenido de los chats) cuando revise una solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remboursements : l'abonnement est un service numérique actif immédiatement et nous ne proposons pas de remboursement. Les demandes sont traitées par Apple selon ses conditions (reportaproblem.apple.com). Si vous acceptez l'option ci-dessus, nous transmettrons à Apple vos données d'utilisation (nombre de lancers/pêches, jamais le contenu des discussions) lors de l'examen d'une demande."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengembalian dana: langganan adalah layanan digital yang langsung aktif, dan kami tidak memberikan pengembalian dana. Permintaan ditangani oleh Apple sesuai kebijakannya (reportaproblem.apple.com). Jika kamu menyetujui opsi di atas, kami akan memberikan data penggunaan (misalnya jumlah lempar/pungut, tanpa isi obrolan) ke Apple saat meninjau permintaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimborsi: l'abbonamento è un servizio digitale attivo subito e non offriamo rimborsi. Le richieste sono gestite da Apple secondo le sue norme (reportaproblem.apple.com). Se accetti l'opzione sopra, quando Apple esamina una richiesta condivideremo i tuoi dati di utilizzo (ad es. numero di lanci/ripescaggi, mai il contenuto delle chat)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返金について：メンバーシップは購入後すぐに有効になるデジタルサービスのため、当社では返金を行っていません。返金のご依頼はAppleが同社のポリシーに基づいて対応します（reportaproblem.apple.com）。上記の項目に同意された場合、Appleが返金リクエストを審査する際に利用状況（流した・拾った回数など。チャット内容は含みません）をAppleに提供します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환불 안내: 멤버십은 구매 즉시 적용되는 디지털 서비스로, 당사는 환불을 제공하지 않습니다. 환불 요청은 Apple이 자체 정책에 따라 처리합니다(reportaproblem.apple.com). 위 항목에 동의하시면 Apple이 환불 요청을 검토할 때 이용 정보(띄우기/줍기 횟수 등, 대화 내용 제외)를 Apple에 제공합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reembolsos: a assinatura é um serviço digital que começa na hora, e não oferecemos reembolso. Os pedidos são tratados pela Apple conforme as políticas dela (reportaproblem.apple.com). Se você aceitar a opção acima, compartilharemos com a Apple seus dados de uso (como número de lançamentos/pescas, nunca o conteúdo das conversas) quando ela analisar um pedido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат: подписка — цифровая услуга, которая начинает действовать сразу, и мы не делаем возвратов. Запросы на возврат рассматривает Apple по своим правилам (reportaproblem.apple.com). Если вы согласитесь с пунктом выше, при рассмотрении запроса мы передадим Apple данные об использовании (например, число бросков и уловов, но не содержание чатов)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การคืนเงิน: สมาชิกเป็นบริการดิจิทัลที่มีผลทันที เราไม่มีนโยบายคืนเงิน คำขอคืนเงินจะได้รับการพิจารณาโดย Apple ตามนโยบายของ Apple (reportaproblem.apple.com) หากคุณยินยอมตามตัวเลือกด้านบน เราจะส่งข้อมูลการใช้งาน (เช่น จำนวนครั้งที่โยน/เก็บขวด ไม่รวมเนื้อหาแชต) ให้ Apple เมื่อพิจารณาคำขอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İade: üyelik hemen etkinleşen dijital bir hizmettir ve iade yapmıyoruz. İade talepleri Apple tarafından kendi politikalarına göre değerlendirilir (reportaproblem.apple.com). Yukarıdaki seçeneği kabul edersen Apple bir talebi incelerken kullanım bilgilerini (ör. atma/toplama sayısı; sohbet içeriği asla) Apple ile paylaşırız."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn tiền: gói thành viên là dịch vụ số có hiệu lực ngay, chúng tôi không hoàn tiền. Yêu cầu hoàn tiền do Apple xử lý theo chính sách của Apple (reportaproblem.apple.com). Nếu bạn đồng ý với tuỳ chọn phía trên, khi Apple xem xét yêu cầu, chúng tôi sẽ cung cấp dữ liệu sử dụng (như số lần thả/nhặt chai, không bao gồm nội dung trò chuyện)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退款说明：会员为虚拟服务，开通后即时生效，我们不提供退款；如需申请，退款由 Apple 依据其政策处理（reportaproblem.apple.com）。若你同意上方选项，Apple 处理退款请求时我们会向其提供你的使用情况（如扔/捡瓶次数），不含聊天内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "退款說明：會員為虛擬服務，開通後即時生效，我們不提供退款；如需申請，退款由 Apple 依據其政策處理（reportaproblem.apple.com）。若你同意上方選項，Apple 處理退款請求時我們會向其提供你的使用情況（如扔/撿瓶次數），不含聊天內容。"
          }
        }
      }
    },
    "paywall.legal.renew": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@، يتجدد تلقائيًا. يُخصم المبلغ من حساب Apple ID عند تأكيد الشراء. يتجدد الاشتراك تلقائيًا بالسعر نفسه خلال 24 ساعة قبل نهاية كل فترة، ما لم يُوقف التجديد التلقائي قبل 24 ساعة على الأقل من نهايتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@, automatische Verlängerung. Die Zahlung wird bei Kaufbestätigung über deine Apple-ID abgerechnet. Das Abo verlängert sich innerhalb von 24 Stunden vor Ende jedes Zeitraums automatisch zum gleichen Preis, sofern die automatische Verlängerung nicht mindestens 24 Stunden vor Ablauf deaktiviert wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@, auto-renewing. Payment is charged to your Apple ID at confirmation of purchase. The subscription renews automatically at the same price within 24 hours before the end of each period unless auto-renew is turned off at least 24 hours before it ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@, renovación automática. El pago se carga a tu cuenta de Apple ID al confirmar la compra. La suscripción se renueva automáticamente al mismo precio en las 24 horas previas al final de cada periodo, salvo que desactives la renovación automática al menos 24 horas antes de que termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@, renouvellement automatique. Le paiement est débité de votre compte Apple ID à la confirmation de l'achat. L'abonnement se renouvelle automatiquement au même prix dans les 24 heures précédant la fin de chaque période, sauf si vous désactivez le renouvellement automatique au moins 24 heures avant la fin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@, diperpanjang otomatis. Pembayaran ditagihkan ke akun Apple ID saat pembelian dikonfirmasi. Langganan otomatis diperpanjang dengan harga yang sama dalam 24 jam sebelum periode berakhir, kecuali perpanjangan otomatis dimatikan paling lambat 24 jam sebelum berakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@, rinnovo automatico. Il pagamento viene addebitato sull'account Apple ID alla conferma dell'acquisto. L'abbonamento si rinnova automaticamente allo stesso prezzo nelle 24 ore precedenti la fine di ogni periodo, a meno che il rinnovo automatico non venga disattivato almeno 24 ore prima della scadenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@、自動更新。購入確定時にApple IDアカウントに請求されます。期間終了の24時間以上前に自動更新をオフにしない限り、期間終了前の24時間以内に同じ価格で自動更新・請求されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@, 자동 갱신. 구매를 확인하면 Apple ID 계정으로 결제됩니다. 기간 종료 최소 24시간 전에 자동 갱신을 끄지 않으면 종료 전 24시간 이내에 같은 가격으로 자동 갱신되고 결제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@, renovação automática. O pagamento é cobrado na sua conta Apple ID ao confirmar a compra. A assinatura é renovada automaticamente pelo mesmo preço nas 24 horas anteriores ao fim de cada período, a menos que a renovação automática seja desativada pelo menos 24 horas antes do fim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@, автопродление. Оплата списывается с аккаунта Apple ID при подтверждении покупки. Подписка автоматически продлевается по той же цене в течение 24 часов до конца каждого периода, если автопродление не отключено как минимум за 24 часа до его окончания."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ ต่ออายุอัตโนมัติ ระบบจะเรียกเก็บเงินจากบัญชี Apple ID เมื่อยืนยันการซื้อ และจะต่ออายุพร้อมเรียกเก็บเงินในราคาเดิมภายใน 24 ชั่วโมงก่อนสิ้นสุดแต่ละรอบ เว้นแต่คุณจะปิดการต่ออายุอัตโนมัติอย่างน้อย 24 ชั่วโมงก่อนหมดอายุ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@, otomatik yenilenir. Ödeme, satın alma onaylandığında Apple Kimliği hesabından alınır. Otomatik yenileme dönem bitiminden en az 24 saat önce kapatılmadıkça abonelik, her dönemin bitiminden önceki 24 saat içinde aynı fiyatla otomatik olarak yenilenir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@, tự động gia hạn. Khoản thanh toán sẽ được tính vào tài khoản Apple ID khi xác nhận mua. Gói sẽ tự động gia hạn với cùng mức giá trong vòng 24 giờ trước khi kết thúc mỗi kỳ, trừ khi bạn tắt tự động gia hạn ít nhất 24 giờ trước khi hết hạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@，自动续期。确认购买后从 Apple ID 账户扣款；当期结束前 24 小时内自动续订并按相同价格扣费，除非你在到期前至少 24 小时关闭自动续期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@，自動續期。確認購買後從 Apple ID 帳戶扣款；當期結束前 24 小時內自動續訂並按相同價格扣費，除非你在到期前至少 24 小時關閉自動續期。"
          }
        }
      }
    },
    "paywall.legal.trial": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا لم تُلغِ قبل انتهاء الفترة التجريبية فسيبدأ الخصم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du nicht vor Ende des Testzeitraums kündigst, wird dir der Betrag berechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you don't cancel before the trial ends, you'll be charged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no cancelas antes de que termine la prueba, se te cobrará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans résiliation avant la fin de l'essai, vous serez facturé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika tidak dibatalkan sebelum masa uji coba berakhir, tagihan akan dimulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se non disdici prima della fine della prova, ti verrà addebitato l'importo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアル終了前に解約しない場合、課金が始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험 기간이 끝나기 전에 해지하지 않으면 결제가 시작됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você não cancelar antes do fim do teste, será cobrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если не отменить до конца пробного периода, начнётся списание оплаты."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่ยกเลิกก่อนสิ้นสุดช่วงทดลองใช้ ระบบจะเริ่มเรียกเก็บเงิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme bitmeden iptal etmezsen ücretlendirilirsin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu không huỷ trước khi hết thời gian dùng thử, bạn sẽ bị tính phí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用结束前未取消将开始扣费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用結束前未取消將開始扣費。"
          }
        }
      }
    },
