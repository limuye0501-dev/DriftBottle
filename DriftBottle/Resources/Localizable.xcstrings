    "block.confirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد الحظر لن تصلك زجاجات أو رسائل من هذا الشخص"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du erhältst dann keine Flaschen und Nachrichten mehr von dieser Person"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You won't receive bottles or messages from this person anymore"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no recibirás botellas ni mensajes de esta persona"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne recevrez plus de bouteilles ni de messages de cette personne"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah diblokir, kamu tidak akan menerima botol dan pesan dari orang ini lagi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non riceverai più bottiglie né messaggi da questa persona"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックすると、この相手からのボトルやメッセージは届かなくなります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단하면 이 사람의 유리병과 메시지를 더 이상 받지 않아요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não vai mais receber garrafas nem mensagens desta pessoa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы больше не будете получать бутылки и сообщения от этого человека"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังบล็อก คุณจะไม่ได้รับขวดและข้อความจากคนนี้อีก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Engellersen bu kişiden artık şişe ve mesaj almazsın"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi chặn, bạn sẽ không nhận chai và tin nhắn từ người này nữa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拉黑后将无法再收到对方的瓶子和消息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封鎖後將無法再收到對方的瓶子和訊息"
          }
        }
      }
    },
