    "settings.delete_msg": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف ملفك الشخصي وزجاجاتك وسجل محادثاتك نهائيًا دون إمكانية الاستعادة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil, Flaschen und Chats werden endgültig gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile, bottles and chats will be permanently deleted. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu perfil, tus botellas y tus chats se eliminarán para siempre. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre profil, vos bouteilles et vos discussions seront définitivement supprimés. Action irréversible."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil, botol, dan riwayat obrolan akan dihapus permanen dan tidak bisa dipulihkan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilo, bottiglie e chat verranno eliminati per sempre. L'operazione è irreversibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィール、ボトル、チャット履歴は完全に削除され、元に戻せません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필, 유리병, 대화 기록이 영구 삭제되며 복구할 수 없어요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu perfil, garrafas e conversas serão excluídos para sempre. Não dá para desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профиль, бутылки и чаты будут удалены навсегда. Это действие нельзя отменить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรไฟล์ ขวด และประวัติแชตจะถูกลบถาวรและกู้คืนไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilin, şişelerin ve sohbet geçmişin kalıcı olarak silinir; geri alınamaz"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ, chai và lịch sử trò chuyện sẽ bị xoá vĩnh viễn, không thể khôi phục"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的资料、瓶子和聊天记录将被永久删除，且无法恢复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的資料、瓶子和聊天記錄將被永久刪除，且無法恢復"
          }
        }
      }
    },
    "settings.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا تسجيل؛ حسابك محفوظ على هذا الجهاز فقط. إذا أعدت تثبيت التطبيق فستبدأ بهوية جديدة ولن تستعيد محادثاتك السابقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Registrierung nötig – dein Konto existiert nur auf diesem Gerät. Nach einer Neuinstallation startest du neu, alte Chats lassen sich nicht wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No sign-up needed — your account lives only on this device. If you reinstall, you'll start fresh and old chats can't be recovered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hace falta registrarse: tu cuenta solo existe en este dispositivo. Si reinstalas la app, empezarás de cero y no podrás recuperar los chats antiguos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune inscription : votre compte n'existe que sur cet appareil. Si vous réinstallez l'app, vous repartirez de zéro et les anciennes discussions seront perdues."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa daftar, akunmu hanya tersimpan di perangkat ini. Jika aplikasi dipasang ulang, kamu mulai sebagai akun baru dan obrolan lama tidak bisa dipulihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna registrazione: l'account esiste solo su questo dispositivo. Se reinstalli l'app ricominci da zero e le vecchie chat non si possono recuperare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録不要で、アカウントはこの端末にのみ保存されます。再インストールすると新しいアカウントになり、以前のチャットは復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가입 없이 이용하며, 계정은 이 기기에만 저장돼요. 앱을 다시 설치하면 새 계정으로 시작하며 이전 대화는 복구할 수 없어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem cadastro: sua conta fica só neste aparelho. Se reinstalar o app, você começa do zero e as conversas antigas não podem ser recuperadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регистрация не нужна — аккаунт хранится только на этом устройстве. После переустановки вы начнёте заново, старые чаты не восстановить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องสมัครสมาชิก บัญชีจะอยู่ในเครื่องนี้เท่านั้น หากติดตั้งแอปใหม่ จะเริ่มต้นเป็นบัญชีใหม่ และกู้แชตเก่าคืนไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt gerekmez; hesabın yalnızca bu cihazda tutulur. Uygulamayı yeniden yüklersen yeni bir kimlikle başlarsın ve eski sohbetler geri gelmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần đăng ký, tài khoản chỉ lưu trên thiết bị này. Nếu cài lại ứng dụng, bạn sẽ bắt đầu với danh tính mới và không thể khôi phục các cuộc trò chuyện cũ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用无需注册，账号仅保存在本机。卸载重装后将以新身份进入，旧聊天无法找回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本應用無需註冊，帳號僅儲存在本機。刪除 App 重新安裝後將以新身份進入，舊聊天無法找回。"
          }
        }
      }
