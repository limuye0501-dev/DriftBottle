    "paywall.consent": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوافق على مشاركة بيانات استخدامي مع Apple عند مراجعتها لطلب استرداد"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin einverstanden, dass Apple bei einer Rückerstattungsanfrage meine Nutzungsdaten erhält"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If I request a refund, Apple may be sent my usage data"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acepto que se comparta mi uso con Apple cuando revise una solicitud de reembolso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'accepte que mes données d'utilisation soient transmises à Apple lors de l'examen d'une demande de remboursement"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya setuju data penggunaan saya diberikan ke Apple saat Apple meninjau permintaan pengembalian dana"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acconsento a fornire ad Apple i miei dati di utilizzo quando esamina una richiesta di rimborso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleが返金リクエストを審査する際、私の利用状況をAppleに提供することに同意します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple이 환불 요청을 처리할 때 내 이용 정보를 Apple에 제공하는 데 동의합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concordo em compartilhar meus dados de uso com a Apple quando ela analisar um pedido de reembolso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Согласен(на) передавать Apple данные об использовании при рассмотрении запроса на возврат"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยินยอมให้ส่งข้อมูลการใช้งานของฉันให้ Apple เมื่อ Apple พิจารณาคำขอคืนเงิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple bir iade talebini incelerken kullanım bilgilerimin Apple ile paylaşılmasını kabul ediyorum"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng ý cung cấp dữ liệu sử dụng của tôi cho Apple khi Apple xử lý yêu cầu hoàn tiền"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同意在 Apple 处理退款请求时，向 Apple 提供我的使用情况"
