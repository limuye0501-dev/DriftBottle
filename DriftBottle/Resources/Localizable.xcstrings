    "onb.locked": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تغيير الجنس والعمر بعد الإرسال"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschlecht und Alter können später nicht geändert werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gender and age can't be changed later"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sexo y la edad no se pueden cambiar después"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le genre et l'âge ne pourront plus être modifiés"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jenis kelamin dan usia tidak bisa diubah setelah dikirim"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Genere ed età non potranno essere modificati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "性別と年齢は登録後に変更できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "성별과 나이는 제출 후 변경할 수 없어요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gênero e idade não podem ser alterados depois"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пол и возраст потом изменить нельзя"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพศและอายุแก้ไขไม่ได้หลังยืนยัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinsiyet ve yaş sonradan değiştirilemez"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giới tính và tuổi không thể thay đổi sau khi gửi"
          }
