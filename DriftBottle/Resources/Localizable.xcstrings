    "home.new_account_limit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للحسابات الجديدة رمي %ld زجاجات كحد أقصى في اليوم الأول. يعود كل شيء طبيعيًا غدًا!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Konten können am ersten Tag höchstens %ld Flaschen werfen. Ab morgen ist alles wieder normal!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New accounts can throw up to %ld bottles on day one. Back to normal tomorrow!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas nuevas pueden lanzar hasta %ld botellas el primer día. ¡Mañana vuelve a la normalidad!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux comptes peuvent lancer %ld bouteilles maximum le premier jour. Retour à la normale demain !"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun baru hanya bisa melempar maksimal %ld botol di hari pertama. Besok kembali normal!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi account possono lanciare al massimo %ld bottiglie il primo giorno. Da domani tutto torna normale!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規アカウントは初日は1日 %ld 本までです。明日から通常どおりに戻ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 계정은 첫날 하루 최대 %ld개까지 띄울 수 있어요. 내일부터는 정상으로 돌아와요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contas novas podem lançar até %ld garrafas no primeiro dia. Amanhã volta ao normal!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для новых аккаунтов в первый день лимит бросков — %ld. Завтра всё вернётся в норму!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีใหม่โยนขวดได้สูงสุด %ld ใบในวันแรก พรุ่งนี้จะกลับมาเป็นปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni hesaplar ilk gün en fazla %ld şişe atabilir. Yarın her şey normale dönüyor!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản mới chỉ được thả tối đa %ld chai trong ngày đầu. Ngày mai sẽ trở lại bình thường!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新账号首日每天最多扔 %ld 个瓶子，明天就恢复正常啦"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新帳號首日每天最多扔 %ld 個瓶子，明天就恢復正常啦"
          }
        }
      }
    },
