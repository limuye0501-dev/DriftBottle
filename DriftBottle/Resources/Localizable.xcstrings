        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้โยนเยอะแล้ว พักสักหน่อย แล้วกลับมาใหม่พรุ่งนี้นะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün epey şişe attın. Biraz dinlen, yarın yine gel."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay bạn thả nhiều quá rồi. Nghỉ chút đã, mai quay lại nhé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天扔得太频繁了，休息一下，明天再来吧"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
