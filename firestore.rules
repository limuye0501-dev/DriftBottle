rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // 资料由 createProfile 云函数创建；客户端只能改昵称和推送 token（性别/年龄/会员/封禁/设备均不可改）
      allow create: if false;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname','fcmToken'])
        && (!('nickname' in request.resource.data) || (request.resource.data.nickname is string
            && request.resource.data.nickname.size() >= 1 && request.resource.data.nickname.size() <= 12));
      match /notices/{n} { allow read: if request.auth.uid == uid;
        allow update: if request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']); }
    }
    match /bottles/{id} {
      allow read: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow write: if false;
    }
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid && !('status' in request.resource.data);
    }
    match /chats/{id} {
      function chat() { return get(/databases/$(db)/documents/chats/$(id)).data; }
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      match /messages/{m} {
        allow read: if signedIn() && request.auth.uid in chat().participants;
        allow create: if signedIn() && request.auth.uid in chat().participants && chat().blocked == false
          && request.resource.data.senderId == request.auth.uid && request.resource.data.isAI == false
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      }
    }
    // bannedDevices / devices / deviceQuota / subscriptions：仅服务端
  }
}
