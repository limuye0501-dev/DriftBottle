rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.isMember == false;
      // 性别、生日、会员状态不可由客户端修改
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['gender','birthday','birthYear','isMember','memberExpiresAt']);
      match /quota/{d} { allow read: if request.auth.uid == uid; }
      match /notices/{n} { allow read: if request.auth.uid == uid;
        allow update: if request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']); }
    }
    match /bottles/{id} {
      allow read: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow write: if false; // 仅 Cloud Functions 写入
    }
    match /reports/{id} { allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid; }
    match /chats/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      match /messages/{m} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(db)/documents/chats/$(id)).data.participants;
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid && request.resource.data.isAI == false
          && request.auth.uid in get(/databases/$(db)/documents/chats/$(id)).data.participants;
      }
    }
  }
}
